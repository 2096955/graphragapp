# Copy to .env and use with: docker run --env-file .env ...
# Comments go on their own lines: docker does not strip comments after a value.

# Which backends to build, in this order. Local models load on first use; remove the ones a
# machine cannot hold. On CPU: about 3 GB with one Laya checkpoint, 6 GB with Laya and AnyJev,
# and 1.7 GB more for the second Laya checkpoint.
BACKENDS=laya,laya-typed,anyjev,jev,catalogue,uniform

# Protects every POST route and enables benchmark runs from the page. Strongly recommended
# on anything reachable by others; without it, anyone who can reach the server can spend
# your Jev budget.
API_TOKEN=

# Origins allowed to call the API from a browser, comma separated. Not needed when the page
# is opened from this server. Example: https://your-team.github.io
ALLOWED_ORIGINS=

# TypeSafe Jev (hosted), through TypeSafe's own API or OpenRouter's Decisions API. Set one key;
# leave both empty to disable Jev. Keys never leave the server.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
OPENROUTER_API_KEY=
# typesafe or openrouter. Empty: OpenRouter when only its key is set, otherwise TypeSafe.
JEV_PROVIDER=
# Empty: jev-latest on TypeSafe, ~typesafe/jev-latest on OpenRouter. A TypeSafe name such as
# jev-latest or jev-1.13 is translated for OpenRouter.
JEV_MODEL=
# USD per million input tokens, for cost reporting when the provider reports no cost.
# Check the current price.
JEV_PRICE_PER_MTOK=0.042

# Local models
# cpu or cuda
DEVICE=cpu
# For the 'laya' backend: english or multilingual. 'laya-typed' is always the typed-decisions checkpoint.
LAYA_CHECKPOINT=english
ANYJEV_MODEL=Qwen/Qwen3-1.7B
# bfloat16, or float32 on CPUs without bfloat16 support
ANYJEV_DTYPE=bfloat16
# raw or L0. For calibration fitted on your labels, use CALIBRATION_DIR below.
ANYJEV_LEVEL=L0
# Holds <backend>.json files made by scripts.fit_calibration, if you make any
CALIBRATION_DIR=calibration
# Below this confidence a decision goes to review. A rule of thumb, not an error guarantee.
MIN_CONFIDENCE=0.8
# true loads local models at start-up instead of on first use
PRELOAD=false

# Optional explanation writer: any OpenAI-compatible chat endpoint (a local Ollama or vLLM
# server works). Without it, explanations use a template.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Arize eval and cost (optional). Use your own space ID and an API key made for this app.
# Traces go out as OTLP/HTTP JSON spans (https://otlp.arize.com/v1/traces).
# Leave empty: the compliance example still runs and shows the sample eval fixture.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=graphrag-compliance
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces

# Key for the compliance pattern hashes (HMAC-SHA256). Set a long random value, for example
# the output of: python -c "import secrets; print(secrets.token_hex(32))"
# Unset, each process makes a random key, so pattern identities do not survive a restart.
COMPLIANCE_HASH_KEY=

# Claims graph (the who-said-what example). auto: FalkorDB when FALKORDB_URL is set or the
# falkordblite package is installed (Python 3.12+); otherwise embedded Kuzu, so it runs with
# nothing extra. With auto, a server that cannot be reached also falls back to Kuzu, and the page
# says so; with falkordb, start-up fails instead. Values: auto, falkordb or kuzu.
CLAIMS_GRAPH=auto
# For example redis://localhost:6379 after: docker run -p 6379:6379 falkordb/falkordb
# The lab keeps one graph there, graphs_lab_claims, and deletes and rebuilds it at start-up.
FALKORDB_URL=

RESULTS_DIR=results
MAX_STATE_CHARS=4000
RATE_LIMIT_PER_MINUTE=120
# Benchmark runs from the page. Defaults to on when API_TOKEN is set.
# EVAL_ENABLED=true
