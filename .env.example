# Runtime profile. Production refuses to start without API_TOKEN.
# COMPLIANCE_HASH_KEY (32+ characters) is required only when ENABLE_COMPLIANCE=true.
APP_ENV=development

# Which decision backends to build, in this order.
BACKENDS=catalogue,laya,anyjev,jev,uniform

# Required in production. Protects every POST route and internal read endpoints.
API_TOKEN=

# Required in production only when ENABLE_COMPLIANCE=true. Generate a random
# value of at least 32 characters. Used as the server-side HMAC key for
# pseudonymous compliance identifiers.
COMPLIANCE_HASH_KEY=

# Persistent compliance graph path. Leave empty in development for a temporary DB.
# Production default: data/compliance.kuzu
COMPLIANCE_DB_PATH=

# Compliance is enabled for the local lab but defaults OFF when APP_ENV=production.
# Production should enable it only after backend-quality, retention, and data-governance review.
ENABLE_COMPLIANCE=true

# Production defaults this gate to 0.95 when compliance is enabled. Leave blank in
# development to preserve the lab behavior. This is a fail-closed gate, not a risk guarantee.
COMPLIANCE_MIN_CONFIDENCE=

# The destructive worked example is for the lab only and defaults off in production.
ENABLE_DEMO_ENDPOINTS=true

# Hosted compliance sends the payload to the hosted decision backend. Keep false
# unless data residency and processor terms explicitly allow that transfer.
ALLOW_HOSTED_COMPLIANCE=false

# Interactive docs default off in production.
ENABLE_DOCS=true

# Origins allowed to call the API from a browser, comma separated.
ALLOWED_ORIGINS=

# TypeSafe Jev (hosted). Leave empty to disable.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# USD per million input tokens, used for cost reporting only. Check current pricing.
JEV_PRICE_PER_MTOK=0.042

# Local models
DEVICE=cpu
LAYA_CHECKPOINT=typed-decisions
ANYJEV_MODEL=Qwen/Qwen3-1.7B
ANYJEV_DTYPE=bfloat16
ANYJEV_LEVEL=L0
CALIBRATION_DIR=calibration
MIN_CONFIDENCE=0.8
PRELOAD=false

# Optional explanation writer: any OpenAI-compatible chat endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Arize eval and cost (optional). Never commit real credentials.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=graphrag-compliance
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces

RESULTS_DIR=results
MAX_STATE_CHARS=4000
RATE_LIMIT_PER_MINUTE=120

# Benchmark runs write result files and may incur hosted-model cost. Opt in explicitly.
EVAL_ENABLED=false
